      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "GC pauses",
      "description": "Time spent in garbage collection pauses per second",
      "targets": [
        {
          "refId": "A",
