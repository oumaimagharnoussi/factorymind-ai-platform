      }
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "Share of the container CPU used by the JVM",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (process_cpu_usage{service=~\"$service\"})",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
