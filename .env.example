# Copy to .env and change the values. Never commit .env.
POSTGRES_USER=factorymind
POSTGRES_PASSWORD=change-me

# Keycloak admin console (http://localhost:8180/auth/admin in dev)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Fake sensor readings for the demo machines (telemetry-service)
SIMULATOR_ENABLED=true

# Alert debounce (alert-service, ISO-8601 durations): time above a limit before an alert is raised,
# and time back below it before the alert is cleared
ALERT_RAISE_AFTER=PT15S
ALERT_CLEAR_AFTER=PT30S

# AI insights: the language model behind reports and the maintenance copilot (risk scoring never needs one).
# none = rule-based reports, the copilot finds manual passages but writes no answer;
# anthropic = Claude (needs ANTHROPIC_API_KEY);
# ollama = free local model (docker compose --profile ollama up, then: docker compose exec ollama ollama pull llama3.2)
AI_CHAT_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_MODEL=llama3.2

# Copilot search by meaning (embeddings in pgvector). none = keyword search only (Postgres full-text);
# ollama = also by meaning (docker compose exec ollama ollama pull nomic-embed-text). Works with Claude for chat.
AI_EMBEDDING_PROVIDER=none
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Analytics warehouse (analytics-service, read by Power BI): time between two loads, simulated past months
# for the demo (rows marked SIMULATED, written once), and the link of the published Power BI report if any
ANALYTICS_REFRESH_INTERVAL=PT5M
ANALYTICS_DEMO_HISTORY=true
POWERBI_REPORT_URL=

# Observability (Grafana http://localhost:3000, Prometheus :9090, traces in Tempo). Share of requests traced:
# 1.0 in the demo, lower it under real load. Grafana dashboards open without login in dev; admin edits them.
TRACING_SAMPLING_PROBABILITY=1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Notifications (notification-service, ADR 0009). In dev every e-mail lands in Mailpit (http://localhost:8025).
# Shared secret between Alertmanager and notification-service, and the service's own Keycloak client secret.
ALERTMANAGER_WEBHOOK_TOKEN=change-me-long-random-string
NOTIFICATION_CLIENT_SECRET=change-me-another-long-random-string
# Production SMTP server (dev uses Mailpit and ignores these)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=FactoryMind AI <notifications@factorymind.example.com>

# Production only (docker-compose.prod.yml)
DOMAIN=factorymind.example.com
IMAGE_PREFIX=ghcr.io/your-github-login/factorymind
IMAGE_TAG=latest
# Any 22-character base64 UUID, generated once: docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=change-me-22-characters
